{
  "dock": {
    "enabled": true,
    "position": "left",
    "width": 56,
    "margin": 0,
    "exclusiveZone": true,
    "entries": [
      "launcher",
      "taskbar",
      "activeWindow",
      "tray",
      "clock",
      "statusIcons",
      "settings",
      "power"
