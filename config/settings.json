    "pinnedApps": [
      {
        "appId": "ghostty",
        "appName": "Terminal",
        "iconName": "com.mitchellh.ghostty",
        "materialIcon": "terminal",
        "desktopFile": "com.mitchellh.ghostty"
      },
      {
        "appId": "code",
        "appName": "VS Code",
        "iconName": "vscode",
        "materialIcon": "code",
        "desktopFile": "code"
      },
      {
        "appId": "microsoft-edge",
        "appName": "Edge",
        "iconName": "microsoft-edge",
        "materialIcon": "language",
        "desktopFile": "microsoft-edge"
      },
      {
        "appId": "cloudmusic",
        "appName": "CloudMusic",
        "iconName": "netease-cloud-music",
        "materialIcon": "music_note",
        "desktopFile": "lutris:rungame/netease-cloud-music"
      }
    ],
    "tray": {
      "enabled": true,
      "compact": false,
      "hiddenIcons": []
    },
    "statusIcons": [
      {
        "id": "kblayout",
        "enabled": true
      },
      {
        "id": "network",
        "enabled": true
      },
      {
        "id": "bluetooth",
        "enabled": true
      },
      {
        "id": "brightness",
        "enabled": true
      },
      {
        "id": "audio",
        "enabled": true
      },
      {
        "id": "battery",
        "enabled": true
      }
    ]
  },
  "border": {
    "thickness": 14,
    "rounding": 20
  },
  "dashboard": {
    "enabled": true,
    "showOnHover": true,
    "width": 780,
    "defaultTab": "dashboard",
    "tabs": [
      {
        "id": "dashboard",
        "label": "Dashboard",
        "enabled": true
      },
      {
        "id": "media",
        "label": "Media",
        "enabled": true
      },
      {
        "id": "performance",
        "label": "Performance",
        "enabled": true
      },
      {
        "id": "workspaces",
        "label": "Workspaces",
        "enabled": true
      }
    ],
    "weather": {
      "location": "auto",
      "units": "metric"
    }
